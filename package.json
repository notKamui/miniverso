    "@epic-web/client-hints": "^1.3.9",
    "@marsidev/react-turnstile": "^1.6.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/query-core": "^5.105.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "^1.7.14",
    "bowser": "^2.15.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.6",
    "recharts": "3.10.1",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "srvx": "^1.0.8",
    "zod": "^4.6.7"
