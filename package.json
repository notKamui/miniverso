{
  "name": "miniverso",
  "version": "1.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env-shell NODE_ENV=development \"node --experimental-strip-types scripts/migrate-run.ts && vite dev --port 3000\"",
    "start": "cross-env NODE_ENV=production node --env-file=.env dist/serve.js",
    "b": "vp run build",
    "build": "cross-env NODE_ENV=production BUILD_ENV=production vp build --mode production",
    "type-check": "tsc --noEmit",
    "tc": "vp run type-check",
    "dev:docker": "docker compose -f docker-compose.dev.yml",
    "db": "drizzle-kit",
    "migrate": "vp run db migrate",
    "auth:secret": "vpx @better-auth/cli@latest secret",
    "auth:generate": "vpx @better-auth/cli@latest generate --y --output ./src/server/db/schema/auth.ts && vp check --fix",
    "deploy": "sh ./deployment/_.deploy.sh",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
